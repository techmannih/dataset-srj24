{
  "name": "@tscircuit/dataset-srj24",
  "version": "0.0.2",
  "description": "Simple Route JSON dataset from 26 production-oriented KiCad and Altium boards",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "samples",
    "kicad_pcb",
    "circuit-json",
    "snapshots",
    "source-files.json",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "generate": "bun scripts/download-and-generate.mjs && bun scripts/generate-ti-altium-samples.mjs",
    "generate:ti": "bun scripts/generate-ti-altium-samples.mjs",
    "generate:example": "bun scripts/generate-obstacle-shapes.mjs",
    "test": "bun scripts/validate.mjs && bun run test:example",
    "test:example": "tsc -p tests/types/tsconfig.json && bun scripts/generate-obstacle-shapes.mjs --check"
  },
